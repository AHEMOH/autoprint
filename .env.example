# Copy this file to .env and adjust values for your environment.

# Required
PRINTER_URI=ipp://my-printer.local/ipp/print
PRINT_WEEKDAY=monday
PRINT_TIME=10:00
TZ=Europe/Berlin

# Optional
PRINTER_NAME=AutoPrinter
# DNS_SERVER=192.168.0.1

# ---------------------------------------------------------------------------
# Print settings - INITIAL values only.
# Once the container has started, these can be changed in the dashboard and
# are then stored in /data/settings.json, which takes precedence over the
# environment. Delete that file to fall back to the values below.
# ---------------------------------------------------------------------------

# IPP print-quality: 4 = normal, 5 = high (more passes, more ink)
PRINT_QUALITY=5

# IPP media-type keyword. "stationery" = plain paper. A photo paper type such
# as "photographic-glossy" switches the printer into photo mode, which lays
# down noticeably more ink (good for flushing the nozzles, sheet gets wetter).
# The dashboard lists the keywords your printer actually supports.
PRINT_MEDIA_TYPE=stationery

# IPP print-content-optimize (auto|photo); only sent if the printer supports it.
PRINT_CONTENT_OPTIMIZE=photo

# Maintenance color strip on every printed user image (on/off) and where it
# goes: "top" prints the CMYK strip first so the nozzles are flushed before
# the actual picture, "bottom" puts it below the picture.
MAINTENANCE_STRIP=on
STRIP_POSITION=top

# Which pool image to print next: roundrobin (longest-unprinted first) or random
IMAGE_ORDER=roundrobin

# Flask session secret (only used for dashboard flash messages). Random per
# start if unset - set it if you want messages to survive container restarts.
# SECRET_KEY=change-me
