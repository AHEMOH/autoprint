# Copy this file to .env and adjust values for your environment.

# Required
PRINTER_URI=ipp://my-printer.local/ipp/print
PRINT_WEEKDAY=monday
PRINT_TIME=10:00
TZ=Europe/Berlin

# Optional
PRINTER_NAME=AutoPrinter
# DNS_SERVER=192.168.0.1

# Append a slim color test strip to every printed user image so all ink
# nozzles (especially yellow) are exercised even when the image itself
# would not cover every channel. Set to "off" to disable.
# Allowed values (case-insensitive): on, off, 1, 0, true, false, yes, no
MAINTENANCE_STRIP=on
